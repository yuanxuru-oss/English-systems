{
  "name": "review-atelier",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "A local-first English review system designed for packaging and iterative desktop releases.",
  "scripts": {
    "sync:version": "node scripts/sync-version.cjs",
    "build": "npm run sync:version && node build-preview.cjs",
    "preview": "node scripts/serve-dist.cjs",
    "build:routes": "node build-routes.cjs",
    "test": "node --test tests/*.test.js",
    "tauri:dev": "npx tauri dev",
    "tauri:build": "npx tauri build --no-bundle"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  }
}
