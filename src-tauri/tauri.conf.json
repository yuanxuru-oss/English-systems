{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "鱼骨头英语复习系统",
  "version": "1.3.0",
  "identifier": "com.yoselin.reviewatelier",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "鱼骨头英语复习系统",
        "width": 1440,
        "height": 920,
        "minWidth": 1180,
        "minHeight": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
